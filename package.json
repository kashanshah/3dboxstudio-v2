{
  "name": "3dboxstudio-v2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run test:geometry && npm run lint && npm run typecheck && npm run build",
    "migrate:legacy-users": "node scripts/migrate-legacy-users.mjs",
    "test": "node --test scripts/*.test.mjs scripts/admin-dashboard.test.cjs scripts/account-actions.test.cjs scripts/email-templates.test.cjs",
    "sync:legacy": "node scripts/migrate-legacy-users.mjs",
    "sync:legacy-assets": "node scripts/legacy-asset-sync.mjs",
    "test:geometry": "node --test scripts/studio-geometry.test.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@fontsource/manrope": "5.3.0",
    "@neondatabase/serverless": "1.1.0",
    "lucide-react": "1.48.0",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "typescript": "6.0.3"
  }
}
