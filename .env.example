# V2 development only. Never use V1 credentials here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Remains false until the reviewed production migration.
SITE_INDEXABLE=false
# Future server-side integrations; not needed for the marketing foundation.
DATABASE_URL=
# One-time migration source. Never use this value in the client bundle.
LEGACY_DATABASE_URL=
LEGACY_SOURCE_NAME=3dboxstudio-v1
# Optional only if you intentionally want seamless legacy sessions at cutover.
MIGRATE_LEGACY_SESSIONS=false

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_PREFIX=v2/dev/

# Admin and notifications
ADMIN_PASSWORD=
ADMIN_EMAIL=
RESEND_API_KEY=
EMAIL_FROM=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional but required for server-side Turnstile verification.
TURNSTILE_SECRET_KEY=
