# V2 development only. Never use V1 credentials here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Remains false until the reviewed production migration.
SITE_INDEXABLE=false
# Future server-side integrations; not needed for the marketing foundation.
DATABASE_URL=
# Repeatable operator-only sync source. Never use this value in the client bundle.
LEGACY_DATABASE_URL=
LEGACY_SOURCE_NAME=3dboxstudio-v1
# Legacy sessions and reset tokens are never imported; sign in afresh in V2.

# Base URL used in verification/reset emails; set to the deployed V2 app origin.
AUTH_APP_URL=http://localhost:3000
# Optional legacy library links; do not point back to V2 after cutover.
LEGACY_SITE_URL=
LEGACY_ASSET_BASE_URL=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
AWS_REGION=
AWS_S3_BUCKET=
# V2 destination prefix. Asset sync defaults to v2/uploads/ if this is omitted.
AWS_S3_PREFIX=v2/dev/
# Optional separate legacy bucket; defaults to AWS_S3_BUCKET when omitted.
LEGACY_AWS_S3_BUCKET=
# Optional legacy object prefix. Defaults to AWS_S3_SHARE_PREFIX when present,
# otherwise the V1 default "shares/".
LEGACY_AWS_S3_PREFIX=
# Objects are copied under AWS_S3_PREFIX + this deterministic subprefix.
LEGACY_ASSET_TARGET_SUBPREFIX=legacy/

# Admin and notifications
ADMIN_DISPLAY_TIMEZONE=America/Toronto
ADMIN_PASSWORD=
ADMIN_EMAIL=
RESEND_API_KEY=
EMAIL_FROM=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional but required for server-side Turnstile verification.
TURNSTILE_SECRET_KEY=
