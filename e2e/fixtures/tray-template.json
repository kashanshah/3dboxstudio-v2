      "bakery tray"
    ],
    "capabilities": [
      "dieline",
      "3d",
      "fold",
      "interior-artwork",
      "full-dieline-artwork"
    ],
    "parameters": [
      {
        "key": "width",
        "label": "Width",
        "unit": "mm",
        "min": 20,
        "max": 600,
        "step": 1,
        "defaultValue": 160
      },
      {
        "key": "height",
        "label": "Height",
        "unit": "mm",
        "min": 10,
        "max": 300,
        "step": 1,
        "defaultValue": 50
      },
      {
        "key": "depth",
        "label": "Depth",
        "unit": "mm",
        "min": 20,
        "max": 600,
        "step": 1,
        "defaultValue": 110
      },
      {
        "key": "thickness",
        "label": "Board thickness",
        "unit": "mm",
        "min": 0.3,
